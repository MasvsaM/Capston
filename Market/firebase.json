{
  "dataconnect": [
    {
      "name": "example",
      "source": "dataconnect/dataconnect.yaml"
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "runtime": "python313"
  },
  "apphosting": {
    "source": ".",
    "rewrites": [
      {
        "source": "**",
        "function": "app"
      }
    ]
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  },
  "storage": {
    "rules": "storage.rules"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "extensions": {
    "preinstall": []
  }
}
